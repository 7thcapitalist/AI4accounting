# Copy to .env.local and fill in. Never commit real values.
# Variables are added here by the issue that introduces them.

# Serpro Integra Contador, demonstration (trial) environment only (task 5.1).
# Trial token comes from the Serpro API Center docs; no e-CNPJ is needed in trial.
INTEGRA_CONTADOR_TRIAL_TOKEN=replace-me
INTEGRA_CONTADOR_CONTRATANTE=00000000000000
INTEGRA_CONTADOR_AUTOR_PEDIDO_DADOS=00000000000000

# Shared secret the accountant sends (Bearer) to POST /api/decision. Unset = route closed.
AI4_ACCOUNTANT_TOKEN=

# NFS-e Nacional (ADN) capture provider, stub only (task 3.2). Leave unset: CI and dev never call the network.
ADN_NFSE_BASE_URL=
